<Project>
  <!-- Central NuGet package versions. Projects reference packages without a Version attribute. -->
  <ItemGroup Label="Dataverse plug-in runtime (.NET Framework 4.6.2)">
    <PackageVersion Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <!-- Builds SupportTicket.Plugins as a plug-in package (.nupkg with dependent assemblies). -->
    <PackageVersion Include="Microsoft.PowerApps.MSBuild.Plugin" Version="2.14.1" />
  </ItemGroup>
  <ItemGroup Label="Developer tools (.NET 10)">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
    <!-- Reads plug-in registration attributes from the net462 assembly without executing it. -->
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- 2.8.x is the last runner line that supports net462; 3.x requires net472+. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
