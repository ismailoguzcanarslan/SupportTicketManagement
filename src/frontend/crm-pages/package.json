{
  "name": "@ogz/crm-pages",
  "version": "0.1.0",
  "private": true,
  "description": "React + Fluent UI 2 dialog pages, built into HTML Web Resources (ogz_/pages/<name>.html and .js).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "build": "tsc -p tsconfig.json && node build.mjs",
    "build:dev": "tsc -p tsconfig.json && node build.mjs --dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fluentui/react-components": "9.75.1",
    "@ogz/crm-client": "0.1.0",
    "@ogz/crm-ui": "0.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
