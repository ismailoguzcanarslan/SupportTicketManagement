<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Developer tool: deploys Web Resources, form events and plug-in registrations to the DEV
    Dataverse environment. Never runs inside Dataverse.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SupportTicket.DeploymentHelper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Update="deployment.settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="deployment.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SupportTicket.DeploymentHelperTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupportTicket.Tools.Dataverse\SupportTicket.Tools.Dataverse.csproj" />
  </ItemGroup>

</Project>
